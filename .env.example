# Cloud KV Storage Configuration for Vercel / Production
# (Choose either Vercel KV or Upstash Redis - 100% Free)

# Option 1: Vercel KV (Auto-populated if created via Vercel Dashboard -> Storage -> KV)
# KV_REST_API_URL=https://your-kv-store.upstash.io
# KV_REST_API_TOKEN=your_kv_token_here

# Option 2: Upstash Redis (From upstash.com -> Database -> REST API)
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# Option 3: Optional JSONBin.io
# JSONBIN_BIN_ID=your_bin_id
# JSONBIN_API_KEY=your_master_key
